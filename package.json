{
  "name": "development_smtp_service",
  "version": "1.0.0",
  "description": "SMTP Service for development supporting filtering and testing",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:bdd": "cucumber-js tests/features/**/*.feature --require tests/features/step_definitions/**/*.js --format @cucumber/pretty-formatter",
    "lint": "eslint src tests"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParseANull/development_smtp_service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ParseANull/development_smtp_service/issues"
  },
  "homepage": "https://github.com/ParseANull/development_smtp_service#readme",
  "dependencies": {
    "express": "^5.2.1",
    "mailparser": "^3.9.3",
    "smtp-server": "^3.18.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@cucumber/pretty-formatter": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "nodemailer": "^8.0.1",
    "supertest": "^7.2.2"
  }
}
